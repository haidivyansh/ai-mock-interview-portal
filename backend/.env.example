# ─── Backend Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in real values. NEVER commit .env to git.

PORT=5000

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Get a free cluster at https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ai-interview-portal?retryWrites=true&w=majority&appName=<AppName>

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── CORS (production only) ────────────────────────────────────────────────────
# Set to your deployed frontend URL to restrict API access
# Leave blank or omit for local dev (defaults to allowing all origins)
# ALLOWED_ORIGIN=https://your-frontend-domain.vercel.app
