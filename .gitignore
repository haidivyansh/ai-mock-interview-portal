# ── Environment files (NEVER commit secrets) ────────────────────────────────
.env
.env.local
.env.*.local
*.env

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
backend/node_modules/
frontend/node_modules/

# ── Build output ──────────────────────────────────────────────────────────────
frontend/dist/
frontend/dist-ssr/

# ── Uploaded resumes (user files, not source code) ───────────────────────────
backend/uploads/*
!backend/uploads/.gitkeep

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# ── Dev / diagnostic files ────────────────────────────────────────────────────
backend/diagnostic_api_test.js
